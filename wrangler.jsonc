{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "horse-sim",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "horse-sim",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "migrations"
    }
  ]
}
